{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-internal"],
  "ignoreDependencies": [
    "tailwindcss",
    "pngjs",
    "@types/pngjs",
    "@anthropic-ai/claude-agent-sdk",
    "fastify",
    "@fastify/cors",
    "@fastify/static",
    "@fastify/websocket"
  ],
  "ignore": [
    "server/src/providers/hook/claude/hooks/claude-hook.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "adapters/vscode/extension.ts"
      ],
      "project": [
        "adapters/**/*.ts",
        "core/src/**/*.ts"
      ]
    },
    "server": {
      "entry": [
        "src/server.ts",
        "src/cli.ts",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "__tests__/**/*.ts"
      ]
    },
    "webview-ui": {
      "entry": [
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}
